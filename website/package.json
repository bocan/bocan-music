{
  "name": "bocan-website",
  "version": "0.1.0",
  "private": true,
  "description": "bocan.app — static site for the Bòcan music player",
  "type": "module",
  "scripts": {
    "prebuild": "test -f static/appcast.xml || bash ../Scripts/build-appcast.sh --offline",
    "build": "eleventy",
    "serve": "eleventy --serve --quiet",
    "clean": "rm -rf _site",
    "check": "node scripts/check-links.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0"
  }
}
